PORT=4173

# Use a model available to your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: enable Google Search on a model that supports grounding.
GEMINI_SEARCH_ENABLED=false
# Keep false: Google Search on Gemini 3.x requires a paid arrangement and explicit cost approval.
GEMINI_SEARCH_BILLING_APPROVED=false
# Keep false until a suitable processing arrangement has been reviewed; explicit user consent is also required.
GEMINI_PRIVATE_DATA_APPROVED=false
GEMINI_DATA_PROCESSING_REFERENCE=
# Optional separate search-compatible Gemini model; defaults to GEMINI_MODEL.
GEMINI_RESEARCH_MODEL=
# Optional Gemini model that returns image output through generateContent.
GEMINI_IMAGE_BILLING_APPROVED=false
GEMINI_IMAGE_MODEL=

# Google OAuth access tokens are short-lived. Keep them on the server.
OPENPATH_SHEETS_TOKEN=
OPENPATH_SHEET_ID=
OPENPATH_SHEET_TAB=Applications
OPENPATH_GMAIL_TOKEN=

# Comma-separated Greenhouse board tokens you are authorized to use.
OPENPATH_GREENHOUSE_BOARDS=

# Required for the hosted application. Keep all keys server-side.
OPENPATH_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENPATH_INTEGRATION_OWNER_ID=

# Durable account data and coordinated AI limits in the EXISTING Supabase project.
# Apply only the reviewed 20261112132337 repair to the audited legacy project.
# Earlier migrations install a global Auth trigger and must not be blindly replayed.
PATH4U_DATA_BACKEND=supabase
# Server attestation is the default, including when this optional flag is absent.
# legacy-ticket is only for a dedicated project with its reviewed ticket migration.
PATH4U_SIGNUP_MODE=server-attested
PATH4U_DEMO_BACKEND=supabase
PATH4U_PUBLIC_DEMO=1
PATH4U_AI_MONITORING=true
PATH4U_AUTH_MONITORING=true
# Old temporary Previews alone may use Redis. These are not needed for the repaired Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PATH4U_TEMPORARY_STORAGE_EXPIRES=

# Reversible hackathon release. Does not change Supabase policies or user accounts.
DEMO_ONLY_MODE=false
# Public metadata at build time; set only to an approved, assigned hostname.
PUBLIC_SITE_URL=https://openpath-ai-demo-03531.vercel.app
# Additional explicitly approved HTTPS origins, comma-separated. Keep the old URL active.
OPENPATH_ALLOWED_ORIGINS=
